{
  "name": "arcade-pack",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "..",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/top", "/score", "/player", "/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "arcade-scores", "database_id": "00f00ff3-0ac3-4192-98f1-a3f343bb285f" }
  ]
}
